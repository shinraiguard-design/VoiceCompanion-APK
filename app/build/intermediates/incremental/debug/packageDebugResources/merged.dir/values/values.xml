<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="accent_primary">#7C5CFF</color>
    <color name="accent_secondary">#39D0D8</color>
    <color name="bg_dark">#0F1115</color>
    <color name="bubble_ai">#2A2140</color>
    <color name="bubble_user">#2C3140</color>
    <color name="danger">#FF5C5C</color>
    <color name="status_idle">#4A4F5C</color>
    <color name="status_listening">#39D0D8</color>
    <color name="status_speaking">#7C5CFF</color>
